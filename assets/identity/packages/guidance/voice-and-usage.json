    "sections": [
      {
        "description": "Use the mark to express multiple source layers passing through one evidence-backed inspection control plane.",
        "id": "inspection-mark",
        "rules": [
          {
            "category": "mark",
            "contexts": [
              "repository",
              "documentation",
              "release",
              "package"
            ],
            "details": [
              "Minimum standalone size: 16 CSS pixels",
              "Preserve the defined safe zone"
            ],
            "governance": {
              "approval": "approve-egolint-usage",
              "provenance": {
                "capturedAt": "2026-09-01T17:40:00Z",
                "method": "human-authored",
                "source": ".identity/brief.md"
              },
              "state": "approved",
              "subject": "usage:egolint",
              "visibility": "public"
            },
            "id": "mark-with-name",
            "instruction": "Pair the mark with the EgoLint name on first-use repository, documentation, release, and package surfaces.",
            "kind": "do",
            "rationale": "The inspection lens communicates function, while the name establishes the product."
          },
          {
            "category": "mark",
            "contexts": [
              "repository",
              "documentation",
              "release",
              "badge"
            ],
            "details": [
              "Link quality claims to versioned reports",
              "Show skipped and unavailable capability states truthfully"
            ],
            "governance": {
              "approval": "approve-egolint-usage",
              "provenance": {
                "capturedAt": "2026-09-01T17:40:00Z",
                "method": "human-authored",
                "source": ".identity/brief.md"
              },
              "state": "approved",
              "subject": "usage:egolint",
              "visibility": "public"
            },
            "id": "mark-no-certification",
            "instruction": "Do not use the mark or lime accent as proof that a repository is certified, secure, universally compliant, or completely evaluated.",
            "kind": "dont",
            "rationale": "A visual identity cannot replace scoped, represented evidence."
          }
        ],
        "title": "Inspection mark"
      }
    ]
