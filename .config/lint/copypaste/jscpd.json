{
  "$schema": "https://www.schemastore.org/jscpd.json",
  "threshold": 3,
  "minLines": 5,
  "minTokens": 50,
  "mode": "strict",
  "reporters": ["consoleFull", "json", "markdown", "html"],
  "ignore": [
    "**/.config/lint/prose/styles/**",
    "**/meta.json",
    "**/notebooks/jupyter/themes/**",
    "**/.cache/**",
    "**/.git/**",
    "**/.history/**",
    "**/.idea/**",
    "**/.next/**",
    "**/.nuxt/**",
    "**/.output/**",
    "**/.pnpm-store/**",
    "**/.pytest_cache/**",
    "**/.ruff_cache/**",
    "**/.terraform/**",
    "**/.turbo/**",
    "**/.venv/**",
    "**/.vercel/**",
    "**/.yarn/**",
    "**/__snapshots__/**",
    "**/build/**",
    "**/coverage/**",
    "**/dist/**",
    "**/generated/**",
    "**/logs/**",
    "**/node_modules/**",
    "**/out/**",
    "**/.reports/**",
    "**/target/**",
    "**/tmp/**",
    "**/venv/**",
    "**/*.lock",
    "**/*.min.*",
    "**/*.svg",
    "**/*.map",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/__snapshots__/**",
    "**/fixtures/generated/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "**/coverage/**",
    "**/tsconfig.json",
    "**/tsconfig.*.json"
  ],
  "absolute": false,
  "gitignore": true,
  "output": ".reports/egolint/jscpd"
}
