{
  "$schema": "https://www.schemastore.org/coffeelint.json",
  "coffeescript_error": {
    "level": "error"
  },
  "duplicate_key": {
    "level": "error"
  },
  "indentation": {
    "level": "error",
    "value": 2
  },
  "line_endings": {
    "level": "error",
    "value": "unix"
  },
  "eol_last": {
    "level": "error"
  },
  "no_tabs": {
    "level": "error"
  },
  "no_trailing_whitespace": {
    "level": "error",
    "allowed_in_comments": false,
    "allowed_in_empty_lines": false
  },
  "no_trailing_semicolons": {
    "level": "error"
  },
  "no_debugger": {
    "level": "error",
    "console": false
  },
  "no_throwing_strings": {
    "level": "error"
  },
  "no_backticks": {
    "level": "error"
  },
  "camel_case_classes": {
    "level": "error"
  },
  "arrow_spacing": {
    "level": "error"
  },
  "spacing_after_comma": {
    "level": "error",
    "ignore_elision": false
  },
  "space_operators": {
    "level": "error",
    "default_parameters": true
  },
  "max_line_length": {
    "level": "warn",
    "value": 100,
    "limitComments": true
  },
  "missing_parseint_radix": {
    "level": "warn"
  },
  "no_nested_string_interpolation": {
    "level": "warn"
  },
  "no_unnecessary_fat_arrows": {
    "level": "warn"
  },
  "no_implicit_braces": {
    "level": "ignore",
    "strict": true
  },
  "no_implicit_parens": {
    "level": "ignore",
    "strict": true
  },
  "empty_constructor_needs_parens": {
    "level": "ignore"
  }
}
