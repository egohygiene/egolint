{
  "$schema": "https://raw.githubusercontent.com/editorconfig-checker/editorconfig-checker/main/.editorconfig-checker.schema.json",
  "Verbose": false,
  "Debug": false,
  "IgnoreDefaults": false,
  "SpacesAfterTabs": false,
  "NoColor": true,
  "Format": "default",
  "Exclude": [
    "(^|/)\\.git/",
    "(^|/)\\.cache/",
    "(^|/)\\.history/",
    "(^|/)\\.idea/",
    "(^|/)\\.next/",
    "(^|/)\\.nuxt/",
    "(^|/)\\.output/",
    "(^|/)\\.pnpm-store/",
    "(^|/)\\.terraform/",
    "(^|/)\\.turbo/",
    "(^|/)\\.venv/",
    "(^|/)\\.yarn/",
    "(^|/)build/",
    "(^|/)coverage/",
    "(^|/)dist/",
    "(^|/)generated/",
    "(^|/)node_modules/",
    "(^|/)out/",
    "(^|/)\\.reports/",
    "(^|/)target/",
    "(^|/)venv/",
    "\\.min\\.[^/]+$",
    "\\.(lock|map)$",
    "(^|/)(package-lock\\.json|pnpm-lock\\.yaml|yarn\\.lock)$"
  ],
  "AllowedContentTypes": [],
  "PassedFiles": [],
  "Disable": {
    "Charset": false,
    "EndOfLine": false,
    "Indentation": true,
    "InsertFinalNewline": false,
    "TrimTrailingWhitespace": false,
    "IndentSize": true,
    "MaxLineLength": true
  }
}
