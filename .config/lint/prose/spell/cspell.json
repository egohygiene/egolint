{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "id": "egohygiene-cspell",
  "name": "Spell Hygiene",
  "description": "Shared spell-checking policy for Ego Hygiene repositories.",
  "enabled": true,
  "language": "en, en-gb, en-us",
  "caseSensitive": false,
  "allowCompoundWords": false,
  "loadDefaultConfiguration": true,
  "useGitignore": true,
  "gitignoreRoot": "${cwd}",
  "globRoot": "${cwd}",
  "enableGlobDot": true,
  "minWordLength": 4,
  "maxFileSize": 1000000,
  "maxDuplicateProblems": 5,
  "maxNumberOfProblems": 10000,
  "ignoreRandomStrings": true,
  "minRandomLength": 40,
  "numSuggestions": 10,
  "suggestionNumChanges": 3,
  "suggestionsTimeout": 500,
  "unknownWords": "report-all",
  "validateDirectives": true,
  "cache": {
    "useCache": true,
    "cacheLocation": "../../../../.cache/cspell/cspell-cache.json",
    "cacheStrategy": "content"
  },
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "../dictionaries/project-words.dictionary",
      "description": "Repository-specific names and domain terminology.",
      "addWords": true
    },
    {
      "name": "backend-terms",
      "path": "../dictionaries/backend-terms.dictionary",
      "description": "Backend, API, database, authentication, and server terminology."
    },
    {
      "name": "frontend-terms",
      "path": "../dictionaries/frontend-terms.dictionary",
      "description": "Frontend, browser, user-interface, and client terminology."
    },
    {
      "name": "devops-cloud-terms",
      "path": "../dictionaries/devops-cloud-terms.dictionary",
      "description": "DevOps, infrastructure, CI/CD, container, and cloud terminology."
    },
    {
      "name": "programming-terms",
      "path": "../dictionaries/programming-terms.dictionary",
      "description": "Cross-language programming constructs and terminology."
    },
    {
      "name": "software-terms",
      "path": "../dictionaries/software-terms.dictionary",
      "description": "Architecture, design, testing, and general software terminology."
    }
  ],
  "import": [
    "@cspell/dict-clojure/cspell-ext.json",
    "@cspell/dict-elisp/cspell-ext.json",
    "@cspell/dict-gdscript/cspell-ext.json",
    "@cspell/dict-gis/cspell-ext.json",
    "@cspell/dict-medicalterms/cspell-ext.json",
    "@cspell/dict-mime-types/cspell-ext.json",
    "@cspell/dict-mnemonics/cspell-ext.json",
    "@cspell/dict-people-names/cspell-ext.json",
    "@cspell/dict-pokemon/cspell-ext.json",
    "@cspell/dict-redis/cspell-ext.json",
    "@cspell/dict-scientific-terms-us/cspell-ext.json",
    "@cspell/dict-vim/cspell-ext.json",
    "@cspell/dict-win32/cspell-ext.json"
  ],
  "dictionaries": [
    "ada",
    "al",
    "aws",
    "backend-terms",
    "bash",
    "clojure",
    "coding-compound-terms",
    "computing-acronyms",
    "cpp-compound-words",
    "cpp-legacy",
    "cpp-refined",
    "cpp",
    "cryptocurrencies-legacy",
    "cryptocurrencies",
    "csharp",
    "css",
    "dart",
    "data-science-models",
    "data-science-tools",
    "data-science",
    "devops-cloud-terms",
    "django",
    "docker",
    "dotnet",
    "elixir",
    "filetypes",
    "flutter",
    "fonts",
    "frontend-terms",
    "fsharp",
    "fullstack",
    "game-development",
    "gaming-terms",
    "gis",
    "git",
    "golang",
    "google",
    "haskell",
    "html-symbol-entities",
    "html",
    "java",
    "julia",
    "k8s",
    "kotlin",
    "latex",
    "lua",
    "makefile",
    "mathematics-terms-us",
    "medical terms",
    "mime-types",
    "mnemonics",
    "monkeyc",
    "networking-terms",
    "node",
    "npm",
    "people-names",
    "php",
    "pokemon",
    "powershell",
    "programming-terms",
    "project-words",
    "public-licenses",
    "python-common",
    "python",
    "r",
    "redis",
    "ruby-gems",
    "ruby",
    "rust-crates",
    "rust",
    "scala",
    "scientific-terms-us",
    "shellscript",
    "software-term-suggestions",
    "software-terms-alternative",
    "software-terms",
    "software-tools",
    "softwareTerms",
    "sql",
    "svelte",
    "swift",
    "terraform",
    "typescript",
    "vim",
    "web-services",
    "win32",
    "zig"
  ],
  "ignorePaths": [
    ".git/**",
    ".cache/**",
    ".engineering/reports/**",
    ".vscode/**",
    "**/node_modules/**",
    "**/vendor/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/.vercel/**",
    "**/build/**",
    "**/coverage/**",
    "**/dist/**",
    "**/dist-*/**",
    "**/generated/**",
    "**/out/**",
    "**/target/**",
    "**/temp/**",
    "**/__snapshots__/**",
    "**/*.snap",
    "**/*.lock",
    "**/*.map",
    "**/*.min.js",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/CHANGELOG.md"
  ],
  "flagWords": [],
  "ignoreRegExpList": [],
  "ignoreWords": [],
  "overrides": [],
  "patterns": [],
  "words": []
}
