# ==============================================================================
# Secretlint Ignore Policy
# ==============================================================================
#
# Secretlint scans the full repository. Exclusions should be limited to
# dependencies, generated artifacts, caches, and tool-generated reports.
#
# Do not ignore documentation, tests, examples, snapshots, or environment files
# globally. Secrets are commonly leaked through those locations.

# Version-control internals
**/.git/**

# Dependencies
**/node_modules/**
**/vendor/**
**/.venv/**
**/venv/**
**/__pypackages__/**

# Tool and language caches
**/.cache/**
**/.mypy_cache/**
**/.pytest_cache/**
**/.ruff_cache/**
**/.tox/**
**/__pycache__/**

# Generated and compiled output
**/build/**
**/dist/**
**/out/**
**/target/**
**/coverage/**
**/generated/**
**/.next/**
**/site/**

# Minified assets and source maps
**/*.min.js
**/*.min.css
**/*.map

# Generated disposable reports
.reports/**

# Deliberately invalid contract fixtures are executed only by their owning
# isolated fixture test and must not contaminate repository-wide secret scans.
tests/fixtures/negative/**
