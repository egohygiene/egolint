{
  "problemMatcher": [
    {
      "owner": "egolint",
      "pattern": [
        {
          "regexp": "^egolint:([^:]+):(\\d+):(\\d+): (error|warning|info): (.+) \\[([^/]+)/([^\\]]+)\\]$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5,
          "code": 7
        }
      ]
    }
  ]
}
