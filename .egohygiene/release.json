{
  "$schema": "https://egohygiene.io/schemas/aether/repository-release/v1.json",
  "schema_version": "egohygiene.repository-release/v1",
  "repository": {
    "id": "egohygiene/egolint",
    "lifecycle": "incubating",
    "release_profile": "cli-library"
  },
  "release": {
    "state": "unreleased",
    "tag_prefix": "v",
    "immutable_tags": true,
    "major_alias": "disabled"
  },
  "changelog": {
    "path": "CHANGELOG.md",
    "format": "keep-a-changelog/1.1",
    "unreleased_heading": "Unreleased"
  },
  "components": [
    {
      "id": "egolint",
      "kind": "crate",
      "version_authority": {
        "kind": "cargo-manifest",
        "path": "Cargo.toml"
      }
    }
  ],
  "delivery": {
    "channels": [
      {
        "kind": "github-release",
        "state": "planned",
        "relay_profile": "binary",
        "notes": "Source adapter exists; final-head hosted qualification and manual-only migration remain pending. No release is claimed."
      },
      {
        "kind": "container-registry",
        "state": "planned",
        "notes": "Repository-owned CLI and full-engine adapters remain unqualified for publication; platform support follows the reviewed base-image contract."
      }
    ]
  },
  "evidence": {
    "source": "required",
    "change": "required",
    "provenance": "required",
    "sbom": "required",
    "signature": "required",
    "rollback": {
      "strategy": "revert-and-successor-tag",
      "instructions": "Preserve immutable tags, assets and image digests. Revert the defective change, revoke an affected distribution channel when supported, and prepare a reviewed corrective successor following docs/releasing.md."
    }
  },
  "automation": {
    "taskfile_path": "Taskfile.yml",
    "tasks": {
      "plan": "release:plan",
      "prepare": "release:prepare",
      "verify": "release:verify",
      "publish": "release:publish"
    },
    "github": {
      "manual_dispatch_required": true,
      "workflow_path": ".github/workflows/release.yml",
      "state": "configured"
    }
  }
}
