{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanView",
  "description": "Public, redacted execution plan suitable for JSON output.",
  "type": "object",
  "properties": {
    "argv": {
      "description": "Redacted argument vector. This is evidence, not shell syntax.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "description": "Availability, applicability and selection reasons for compiled capabilities.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/CapabilityDecision"
      }
    },
    "config_sources": {
      "description": "Ordered configuration provenance.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "enforcement_mode": {
      "description": "Adoption mode is independent of the selected profile.",
      "$ref": "#/$defs/EnforcementMode"
    },
    "image": {
      "description": "Immutable or tagged image reference requested by configuration.",
      "type": "string"
    },
    "invocation": {
      "$ref": "#/$defs/Invocation"
    },
    "operation": {
      "description": "Check or fix capability.",
      "$ref": "#/$defs/Operation"
    },
    "policy_sha256": {
      "description": "Effective policy identity excludes adoption-mode/baseline self-references.",
      "type": "string"
    },
    "profile": {
      "description": "Selected named profile.",
      "$ref": "#/$defs/Profile"
    },
    "report_directory": {
      "description": "Workspace-relative report directory.",
      "type": "string"
    },
    "runtime": {
      "description": "Container runtime executable.",
      "type": "string"
    },
    "schema_version": {
      "description": "Output contract version.",
      "type": "integer",
      "const": 1
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "workspace": {
      "description": "Canonical host workspace.",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "operation",
    "profile",
    "runtime",
    "image",
    "workspace",
    "report_directory",
    "config_sources",
    "argv",
    "capabilities",
    "enforcement_mode",
    "invocation",
    "policy_sha256"
  ],
  "$defs": {
    "CapabilityDecision": {
      "description": "Public-safe explanation; never contains manifest values or file contents.",
      "type": "object",
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "available": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "placement": {
          "$ref": "#/$defs/Placement"
        },
        "provider": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/CapabilityState"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "provider",
        "placement",
        "available",
        "applicable",
        "state",
        "reason"
      ]
    },
    "CapabilityState": {
      "description": "Selection is not evidence that an executable actually ran or passed.",
      "type": "string",
      "enum": [
        "available",
        "applicable",
        "selected",
        "skipped",
        "unavailable",
        "invalid"
      ]
    },
    "EnforcementMode": {
      "description": "Existing consumers retain blocking behavior unless they explicitly select another mode.",
      "type": "string",
      "enum": [
        "manual",
        "observe",
        "ratchet",
        "enforce"
      ]
    },
    "Invocation": {
      "description": "Invocation provenance is data, not a command or publication authorization.",
      "type": "string",
      "enum": [
        "local",
        "workflow_dispatch",
        "pull_request",
        "push",
        "schedule",
        "release",
        "automatic"
      ]
    },
    "Operation": {
      "description": "Requested lint operation and its workspace write capability.",
      "oneOf": [
        {
          "description": "Analyze without granting broad workspace writes.",
          "type": "string",
          "const": "check"
        },
        {
          "description": "Explicitly allow tools to update workspace files.",
          "type": "string",
          "const": "fix"
        }
      ]
    },
    "Placement": {
      "description": "A capability's owning execution boundary.",
      "type": "string",
      "enum": [
        "full_image",
        "native",
        "host_adapter",
        "configuration_only",
        "specialized_image"
      ]
    },
    "Profile": {
      "description": "Built-in lint profiles.",
      "oneOf": [
        {
          "description": "Changed-file adapter feedback plus full-repository native policy checks.",
          "type": "string",
          "const": "fast"
        },
        {
          "description": "Complete scheduled, manual, and trusted-branch inspection.",
          "type": "string",
          "const": "holistic"
        },
        {
          "description": "Focused secret, static-analysis, and infrastructure security inspection.",
          "type": "string",
          "const": "security"
        },
        {
          "description": "Focused dependency vulnerability and software-inventory inspection.",
          "type": "string",
          "const": "dependency-debt"
        }
      ]
    },
    "SourceSnapshot": {
      "description": "Commit/tree provenance is explicit about dirty or unavailable source.",
      "type": "object",
      "properties": {
        "commit": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        },
        "tree": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "dirty"
      ]
    }
  }
}
