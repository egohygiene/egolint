{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepositoryContinuityReport",
  "description": "Dedicated deterministic continuity report.",
  "type": "object",
  "properties": {
    "aether_contract": {
      "$ref": "#/$defs/ContinuityAetherLock"
    },
    "applicability": {
      "$ref": "#/$defs/ContinuityRequirement"
    },
    "catalog_version": {
      "type": "string"
    },
    "comparison": {
      "$ref": "#/$defs/ContinuityComparisonReport"
    },
    "contract": {
      "type": "string"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ContinuityDiagnostic"
      }
    },
    "evidence_layers": {
      "$ref": "#/$defs/ContinuityEvidenceLayers"
    },
    "hygiene_profile": {
      "$ref": "#/$defs/ContinuityHygieneLock"
    },
    "policy_path": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "rollout_stage": {
      "$ref": "#/$defs/ContinuityRolloutStage"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "status": {
      "$ref": "#/$defs/ContinuityValidationStatus"
    },
    "summary": {
      "$ref": "#/$defs/ContinuityValidationSummary"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "catalog_version",
    "repository",
    "policy_path",
    "rollout_stage",
    "applicability",
    "hygiene_profile",
    "aether_contract",
    "comparison",
    "evidence_layers",
    "status",
    "summary",
    "diagnostics"
  ],
  "$defs": {
    "ContinuityAetherLock": {
      "description": "Immutable Aether compatibility range selected by a repository.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "lifecycle": {
          "type": "string"
        },
        "maximum-version-exclusive": {
          "type": "string"
        },
        "minimum-version": {
          "type": "string"
        },
        "release-included": {
          "type": "boolean"
        },
        "selected-version": {
          "type": "string"
        },
        "source-path": {
          "type": "string"
        },
        "source-repository": {
          "type": "string"
        },
        "source-revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "selected-version",
        "minimum-version",
        "maximum-version-exclusive",
        "lifecycle",
        "release-included",
        "source-repository",
        "source-revision",
        "source-path"
      ]
    },
    "ContinuityComparisonReport": {
      "description": "Complete base/head comparison summary.",
      "type": "object",
      "properties": {
        "agents_changed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "base": {
          "$ref": "#/$defs/ContinuityRevisionEvidence"
        },
        "continuity_changed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "disposition": {
          "$ref": "#/$defs/ContinuityDisposition"
        },
        "head": {
          "$ref": "#/$defs/ContinuityRevisionEvidence"
        },
        "live_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "live_verification": {
          "$ref": "#/$defs/ContinuityLiveVerification"
        },
        "parallel_checkpoint_conflicts": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "parallel_heads_requested": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "shallow_repository": {
          "type": "boolean"
        },
        "topology": {
          "$ref": "#/$defs/ContinuityTopology"
        },
        "transition": {
          "$ref": "#/$defs/ContinuityTransition"
        }
      },
      "additionalProperties": false,
      "required": [
        "base",
        "head",
        "topology",
        "shallow_repository",
        "parallel_heads_requested",
        "parallel_checkpoint_conflicts",
        "disposition",
        "transition",
        "live_verification",
        "live_evidence"
      ]
    },
    "ContinuityDiagnostic": {
      "description": "One privacy-safe continuity diagnostic. Checkpoint prose is never copied.",
      "type": "object",
      "properties": {
        "actual_state": {
          "type": "string"
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_state": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        },
        "remediation": {
          "type": "string"
        },
        "rule_id": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "rule_id",
        "severity",
        "expected_state",
        "actual_state",
        "message",
        "remediation",
        "contracts"
      ]
    },
    "ContinuityDisposition": {
      "description": "Pull-request update declaration supplied by the invoking workflow.",
      "oneOf": [
        {
          "description": "The candidate intentionally updates the continuity checkpoint.",
          "type": "string",
          "const": "updated"
        },
        {
          "description": "A reviewer determined that the existing checkpoint remains current.",
          "type": "string",
          "const": "reviewed_no_change"
        },
        {
          "description": "A reviewed, unexpired exception permits no checkpoint update.",
          "type": "string",
          "const": "exception"
        }
      ]
    },
    "ContinuityEvidenceLayers": {
      "description": "Explicit separation between deterministic and external evidence.",
      "type": "object",
      "properties": {
        "external_live_state": {
          "$ref": "#/$defs/ContinuityEvidenceStatus"
        },
        "freshness_declaration": {
          "$ref": "#/$defs/ContinuityEvidenceStatus"
        },
        "local_git": {
          "$ref": "#/$defs/ContinuityEvidenceStatus"
        },
        "structural": {
          "$ref": "#/$defs/ContinuityEvidenceStatus"
        }
      },
      "additionalProperties": false,
      "required": [
        "structural",
        "freshness_declaration",
        "local_git",
        "external_live_state"
      ]
    },
    "ContinuityEvidenceStatus": {
      "description": "Status of one separately bounded evidence layer.",
      "type": "string",
      "enum": [
        "valid",
        "invalid",
        "incomplete",
        "verified",
        "unavailable",
        "not_applicable",
        "requires_external_verification"
      ]
    },
    "ContinuityHygieneLock": {
      "description": "Immutable Hygiene policy lock selected by a repository.",
      "type": "object",
      "properties": {
        "digest": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "source-path": {
          "type": "string"
        },
        "source-repository": {
          "type": "string"
        },
        "source-revision": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "status",
        "source-repository",
        "source-revision",
        "source-path",
        "digest"
      ]
    },
    "ContinuityLiveVerification": {
      "description": "Whether a separate adapter supplied live-state verification evidence.",
      "oneOf": [
        {
          "description": "Ordinary offline validation has no external live-state evidence.",
          "type": "string",
          "const": "unavailable"
        },
        {
          "description": "A caller supplied stable evidence from an authorized live-state adapter.",
          "type": "string",
          "const": "verified"
        }
      ]
    },
    "ContinuityRequirement": {
      "description": "Requirement resulting from Hygiene applicability resolution.",
      "type": "string",
      "enum": [
        "required",
        "advisory",
        "not_applicable"
      ]
    },
    "ContinuityRevisionEvidence": {
      "description": "Privacy-safe representation of one requested revision.",
      "type": "object",
      "properties": {
        "requested": {
          "type": "string"
        },
        "resolved_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/ContinuityRevisionState"
        }
      },
      "additionalProperties": false,
      "required": [
        "requested",
        "state"
      ]
    },
    "ContinuityRevisionState": {
      "description": "Availability of one explicit Git revision.",
      "type": "string",
      "enum": [
        "available",
        "unavailable",
        "unborn",
        "working_tree"
      ]
    },
    "ContinuityRolloutStage": {
      "description": "Hygiene rollout stage applied to continuity diagnostics.",
      "oneOf": [
        {
          "description": "Findings are visible but capped at warning severity.",
          "type": "string",
          "const": "observe"
        },
        {
          "description": "Only findings absent from the represented base remain blocking.",
          "type": "string",
          "const": "ratchet"
        },
        {
          "description": "Every error-level finding remains blocking.",
          "type": "string",
          "const": "enforce"
        }
      ]
    },
    "ContinuityTopology": {
      "description": "Local topology determined without fetching.",
      "type": "string",
      "enum": [
        "linear",
        "merge_commit",
        "diverged",
        "same_revision",
        "working_tree",
        "unborn",
        "unavailable"
      ]
    },
    "ContinuityTransition": {
      "description": "Lifecycle transition represented by the comparison.",
      "oneOf": [
        {
          "description": "A candidate branch is being prepared or reviewed.",
          "type": "string",
          "const": "pull_request"
        },
        {
          "description": "A merge result is being reconciled after external merge confirmation.",
          "type": "string",
          "const": "post_merge"
        }
      ]
    },
    "ContinuityValidationStatus": {
      "description": "Semantic validity independent of rollout-stage severity.",
      "type": "string",
      "enum": [
        "valid",
        "invalid",
        "incomplete",
        "not_applicable"
      ]
    },
    "ContinuityValidationSummary": {
      "description": "Exact bounded counts for Relay, Pace, and Observatory consumers.",
      "type": "object",
      "properties": {
        "blocking_diagnostics": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "diagnostics": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "exceptions_applied": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "exceptions_available": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "files_checked": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "markdown_links_checked": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "parallel_heads_checked": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "provider_projections_checked": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "diagnostics",
        "blocking_diagnostics",
        "files_checked",
        "provider_projections_checked",
        "markdown_links_checked",
        "exceptions_available",
        "exceptions_applied",
        "parallel_heads_checked"
      ]
    },
    "Severity": {
      "description": "Normalized finding severity.",
      "oneOf": [
        {
          "description": "Informational observation.",
          "type": "string",
          "const": "info"
        },
        {
          "description": "Nonblocking warning.",
          "type": "string",
          "const": "warning"
        },
        {
          "description": "Blocking correctness or policy failure.",
          "type": "string",
          "const": "error"
        },
        {
          "description": "Urgent high-impact security or safety failure.",
          "type": "string",
          "const": "critical"
        }
      ]
    },
    "SourceLocation": {
      "description": "Workspace-relative source location.",
      "type": "object",
      "properties": {
        "end_column": {
          "description": "One-based ending column.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "end_line": {
          "description": "One-based ending line.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "path": {
          "description": "Normalized path relative to the inspected workspace.",
          "type": "string"
        },
        "start_column": {
          "description": "One-based starting column.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "start_line": {
          "description": "One-based starting line.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    }
  }
}
