{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.io/schemas/egolint/javascript-architecture-profile.v1.schema.json",
  "title": "Egolint JavaScript and TypeScript architecture profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "policy_source", "adapter", "roots", "rules"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "policy_source": { "type": "string", "minLength": 1 },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "dependency-cruiser" },
        "version": { "const": "18.2.0" }
      }
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "restriction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/strings" },
        "path_not": { "$ref": "#/$defs/strings" },
        "circular": { "type": "boolean" },
        "orphan": { "type": "boolean" },
        "could_not_resolve": { "type": "boolean" },
        "dependency_types": { "$ref": "#/$defs/strings" },
        "dependency_types_not": { "$ref": "#/$defs/strings" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "description", "from", "to", "remediation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "severity": { "enum": ["info", "warning", "error"] },
        "description": { "type": "string", "minLength": 1 },
        "from": { "$ref": "#/$defs/restriction" },
        "to": { "$ref": "#/$defs/restriction" },
        "remediation": { "type": "string", "minLength": 1 }
      }
    },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
