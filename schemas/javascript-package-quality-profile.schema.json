{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.io/schemas/egolint/javascript-package-quality-profile/v1.json",
  "title": "Egolint JavaScript package-quality profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "policy_source",
    "adapters",
    "variants",
    "fix_policy"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "const": "egolint/javascript-package-quality"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "policy_source": {
      "type": "string",
      "minLength": 1
    },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oxlint",
        "oxlint_tsgolint",
        "biome",
        "publint"
      ],
      "properties": {
        "oxlint": {
          "$ref": "#/$defs/adapter"
        },
        "oxlint_tsgolint": {
          "$ref": "#/$defs/adapter"
        },
        "biome": {
          "allOf": [
            {
              "$ref": "#/$defs/adapter"
            },
            {
              "type": "object",
              "required": [
                "linter_enabled"
              ],
              "properties": {
                "linter_enabled": {
                  "const": false
                }
              }
            }
          ]
        },
        "publint": {
          "allOf": [
            {
              "$ref": "#/$defs/adapter"
            },
            {
              "type": "object",
              "required": [
                "applicability"
              ],
              "properties": {
                "applicability": {
                  "const": "manifest_publication_npm"
                }
              }
            }
          ]
        }
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "react-library"
      ],
      "properties": {
        "base": {
          "$ref": "#/$defs/variant"
        },
        "react-library": {
          "$ref": "#/$defs/variant"
        }
      }
    },
    "fix_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_mode",
        "safe_fixes",
        "dangerous_fixes"
      ],
      "properties": {
        "default_mode": {
          "const": "check"
        },
        "safe_fixes": {
          "const": "explicit"
        },
        "dangerous_fixes": {
          "const": "never_automatic"
        }
      }
    }
  },
  "$defs": {
    "adapter": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "version",
        "owner"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string"
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oxlint_config",
        "biome_config",
        "capabilities"
      ],
      "properties": {
        "oxlint_config": {
          "type": "string",
          "minLength": 1
        },
        "biome_config": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
