{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.io/schemas/egolint/javascript-architecture-overlay.v1.schema.json",
  "title": "Egolint JavaScript architecture repository overlay v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "add_rules", "exceptions"],
  "properties": {
    "schema_version": { "const": 1 },
    "profile_id": { "const": "javascript-typescript-architecture" },
    "add_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "exceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exception" }
    }
  },
  "$defs": {
    "restriction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/strings" },
        "path_not": { "$ref": "#/$defs/strings" },
        "circular": { "type": "boolean" },
        "orphan": { "type": "boolean" },
        "could_not_resolve": { "type": "boolean" },
        "dependency_types": { "$ref": "#/$defs/strings" },
        "dependency_types_not": { "$ref": "#/$defs/strings" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "description", "from", "to", "remediation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "severity": { "enum": ["info", "warning", "error"] },
        "description": { "type": "string", "minLength": 1 },
        "from": { "$ref": "#/$defs/restriction" },
        "to": { "$ref": "#/$defs/restriction" },
        "remediation": { "type": "string", "minLength": 1 }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule_id", "owner", "reason", "expires_on", "from", "to"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "rule_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "owner": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "expires_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "from": { "type": ["string", "null"] },
        "to": { "type": ["string", "null"] }
      }
    },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
