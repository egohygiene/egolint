{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.io/schemas/egolint/javascript-package-quality-manifest/v1.json",
  "title": "Egolint JavaScript package-quality manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "package_path", "publication"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "profile": {
      "enum": ["base", "react-library"]
    },
    "package_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "publication": {
      "enum": ["npm", "private"]
    },
    "ignore": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!!)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
      }
    }
  }
}
