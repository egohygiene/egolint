{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnforcementDecision",
  "description": "Effective process result is separate from the run's actual findings/execution status.",
  "type": "object",
  "properties": {
    "baseline_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "baseline_status": {
      "$ref": "#/$defs/BaselineStatus"
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FindingDelta"
      }
    },
    "effective_exit_code": {
      "type": "integer",
      "format": "int32"
    },
    "execution_skipped": {
      "type": "boolean"
    },
    "invocation": {
      "$ref": "#/$defs/Invocation"
    },
    "mode": {
      "$ref": "#/$defs/EnforcementMode"
    },
    "reason": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "invocation",
    "execution_skipped",
    "baseline_status",
    "effective_exit_code",
    "changes",
    "reason"
  ],
  "$defs": {
    "BaselineFinding": {
      "description": "Baseline entries carry no source excerpt or raw diagnostic message.",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "fingerprint": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "rule_id": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "tool_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "tool_id",
        "rule_id",
        "severity",
        "count"
      ]
    },
    "BaselineStatus": {
      "type": "string",
      "enum": [
        "not_used",
        "valid",
        "expired",
        "incompatible",
        "unavailable"
      ]
    },
    "EnforcementMode": {
      "description": "Existing consumers retain blocking behavior unless they explicitly select another mode.",
      "type": "string",
      "enum": [
        "manual",
        "observe",
        "ratchet",
        "enforce"
      ]
    },
    "FindingDelta": {
      "type": "object",
      "properties": {
        "blocking": {
          "type": "boolean"
        },
        "finding": {
          "$ref": "#/$defs/BaselineFinding"
        },
        "state": {
          "$ref": "#/$defs/FindingState"
        }
      },
      "additionalProperties": false,
      "required": [
        "finding",
        "state",
        "blocking"
      ]
    },
    "FindingState": {
      "description": "Debt state remains visible even when adoption makes it nonblocking.",
      "type": "string",
      "enum": [
        "resolved",
        "unchanged",
        "new",
        "worsened",
        "suppressed",
        "expired",
        "unavailable"
      ]
    },
    "Invocation": {
      "description": "Invocation provenance is data, not a command or publication authorization.",
      "type": "string",
      "enum": [
        "local",
        "workflow_dispatch",
        "pull_request",
        "push",
        "schedule",
        "release",
        "automatic"
      ]
    },
    "Severity": {
      "description": "Normalized finding severity.",
      "oneOf": [
        {
          "description": "Informational observation.",
          "type": "string",
          "const": "info"
        },
        {
          "description": "Nonblocking warning.",
          "type": "string",
          "const": "warning"
        },
        {
          "description": "Blocking correctness or policy failure.",
          "type": "string",
          "const": "error"
        },
        {
          "description": "Urgent high-impact security or safety failure.",
          "type": "string",
          "const": "critical"
        }
      ]
    }
  }
}
