{
  "$schema": "./schemas/javascript-package-quality-manifest.schema.json",
  "schema_version": 1,
  "profile": "base",
  "package_path": ".",
  "publication": "private",
  "ignore": [
    ".venv/**",
    "venv/**",
    "assets/identity/**",
    "vendor/aether/**",
    "vendor/hygiene/**",
    "vendor/github/issue-titles/**",
    "schemas/*.schema.json",
    ".config/megalinter/tool-matrix.json",
    ".config/megalinter/v10-catalog.json",
    ".config/toolchain/complementary-tools.json",
    ".config/toolchain/tool-matrix.json",
    "tests/fixtures/**"
  ]
}
